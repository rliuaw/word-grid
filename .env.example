# Hugging Face token (required for gated model access)
HF_TOKEN=hf_your_token_here

# Weights & Biases API key (required for experiment logging)
WANDB_API_KEY=your_wandb_api_key_here

# Optional: W&B project and entity
WANDB_PROJECT=word-grid
WANDB_ENTITY=

# Optional: Override default model paths
# GENERATOR_MODEL=unsloth/Magistral-Small-2509-bnb-4bit
# DISCRIMINATOR_MODEL=mistralai/Ministral-3-8B-Reasoning-2512-GGUF
# DISCRIMINATOR_GGUF_FILE=Ministral-3-8B-Reasoning-2512.Q4_K_M.gguf
